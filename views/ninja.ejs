<% layout('layouts/main') %>
<section class="page-hero compact"><div class="container"><p class="eyebrow"><%= ninja.category %> · <%= ninja.rank %></p><h1><%= ninja.title %></h1><p><%= ninja.short %></p></div></section>
<section class="container section-pad"><div class="row align-items-center g-5"><div class="col-md-5"><div class="detail-art"><img src="<%= ninja.avatar %>" alt="<%= ninja.title %>"></div></div><div class="col-md-7"><p class="eyebrow">СВИТОК № <%= ninja.nick.toUpperCase() %></p><h2>Описание</h2><p class="detail-copy"><%= ninja.desc %></p><h3 class="mt-4">Ключевые качества</h3><div class="skill-list"><% ninja.skills.forEach(skill => { %><span><%= skill %></span><% }) %></div><a class="btn btn-outline-light mt-4" href="/library">← Вернуться в архив</a></div></div></section>
